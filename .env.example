# Copy this file to .env and fill in real values. Never commit .env.
# Online, the same names go in GitHub Actions secrets (jobs) and Vercel/Netlify env vars (web).

# Windy Webcams API v3 (jobs only)
WINDY_API_KEY=

# Supabase, server side (jobs only; the service role key bypasses row-level security)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase, browser side (web/; only VITE_* vars reach the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin page (/admin), server side only: Vercel env vars + local .env, never VITE_*.
# At least 16 characters. The Vercel function also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
ADMIN_PASSWORD=

# Surf alerts (web push). Make the pair with: npm --prefix web run vapid-keys (writes .env).
# Public key: Vercel env (Production + Preview) and .env. Private key + subject: GitHub
# Actions secrets and .env only (never a VITE_* variable, never Vercel).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://isitworthsurf.vercel.app
